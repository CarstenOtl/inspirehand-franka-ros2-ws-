# Flat AprilTag plate matching the physical flange-mounted holder
# Printed face pose is defined by its parent body in the MJCF scene
# Black square: 40 mm; full face including quiet zone: 50 mm
# Raw mesh thickness: 2.3 mm; MJCF offsets its local z=0.0023 printed face to TCP z=0
v -0.025 -0.025 0.0000
v  0.025 -0.025 0.0000
v  0.025  0.025 0.0000
v -0.025  0.025 0.0000
v -0.025 -0.025 0.0023
v  0.025 -0.025 0.0023
v  0.025  0.025 0.0023
v -0.025  0.025 0.0023

# Printed face preserves the previous U=-Y, V=+X orientation.
# The texture corners are white, so the remaining faces render as plate edges.
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0
vt 0.0 0.0

# Printed/front face (+Z).
f 5/1 6/2 7/3
f 5/1 7/3 8/4

# Back and four plate edges.
f 1/4 4/4 3/4
f 1/4 3/4 2/4
f 1/4 2/4 6/4
f 1/4 6/4 5/4
f 2/4 3/4 7/4
f 2/4 7/4 6/4
f 3/4 4/4 8/4
f 3/4 8/4 7/4
f 4/4 1/4 5/4
f 4/4 5/4 8/4
