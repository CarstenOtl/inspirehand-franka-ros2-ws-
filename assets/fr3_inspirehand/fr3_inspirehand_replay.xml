<mujoco model="fr3_inspirehand_replay">
  <!-- MuJoCo visualization scene for the recorded forgeUltra FR3 threading
       trajectory. The exact baked M24 meshes come from tiangong_infra_ws's
       tuned forgeultra_full_task_scene.xml. Workcell dimensions, presentation,
       robot transform, and hand kinematics match the recorded FR3 run.

       All mesh paths are relative to this file and stay inside this asset
       bundle. fr3_link8 is the flange frame, 107 mm beyond fr3_link7. The hand
       geometry and physical settings come from Open-X-Humanoid's official
       TienKung 2 Pro URDF; a pi-yaw adapter flips the hand from its zero-yaw
       pose and places it 90 degrees from the legacy physical FR3 adapter. -->

  <compiler angle="radian" meshdir="./"/>

  <option integrator="implicitfast"/>

  <size nkey="1"/>

  <visual>
    <global azimuth="120" elevation="-20" offwidth="1280" offheight="720"/>
    <headlight ambient="0.45 0.45 0.45" diffuse="0.55 0.55 0.55" specular="0 0 0"/>
    <rgba haze="0.7 0.7 0.7 1"/>
  </visual>

  <default>
    <default class="fr3">
      <joint armature="0.195" damping="0.21" frictionloss="1.137"/>
      <site size="0.001 0.005 0.005" group="4" rgba="0.5 0.5 0.5 0.3"/>
      <general biastype="affine" biasprm="0 -1"/>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom type="mesh" group="3"/>
      </default>
    </default>

    <default class="official_hand">
      <joint damping="1" frictionloss="0.5" actuatorfrcrange="-50 50"/>
      <default class="hand_visual">
        <geom type="mesh" contype="0" conaffinity="0" group="1" material="hand_shell" density="0"/>
      </default>
      <default class="hand_collision">
        <geom type="mesh" group="3" rgba="1 1 1 0"/>
      </default>
    </default>

  </default>

  <asset>
    <!-- Neutral Isaac-style viewer background used by the source replay. -->
    <texture type="skybox" colorspace="auto" builtin="flat" rgb1="0.92 0.92 0.92" width="512" height="3072"/>
    <texture type="2d" colorspace="auto" name="groundplane" builtin="checker" mark="edge" rgb1="0.31 0.31 0.31" rgb2="0.31 0.31 0.31" markrgb="0.78 0.78 0.78" width="300" height="300"/>
    <texture type="2d" colorspace="auto" name="apriltag_36h11_id0_texture"
      file="textures/apriltag_36h11_id0.png"/>
    <material name="black" rgba="0.2 0.2 0.2 1"/>
    <material name="white"/>
    <material name="red" rgba="1 0.072272 0.039546 1"/>
    <material name="gray" rgba="0.863156 0.863156 0.863157 1"/>
    <material name="button_green" rgba="0.102241 0.571125 0.102242 1"/>
    <material name="button_red" rgba="0.520996 0.008023 0.013702 1"/>
    <material name="button_blue" rgba="0.024157 0.445201 0.737911 1"/>
    <material name="groundplane" texture="groundplane" texrepeat="2 2" texuniform="true" reflectance="0.05"/>
    <texture name="forge_walnut" type="2d" file="textures/forge/walnut_albedo.png"/>
    <material name="forge_table" texture="forge_walnut" texrepeat="4 4" texuniform="true" reflectance="0.03" roughness="0.34"/>
    <!-- The captured Isaac replay renders the bench top white even though the
         saved environment flag names the walnut USD variant. -->
    <material name="recorded_table_top" rgba="0.93 0.93 0.91 1" roughness="0.55"/>
    <material name="recorded_table_leg" rgba="0.13 0.14 0.15 1" roughness="0.35" metallic="0.65"/>
    <material name="forge_bolt" rgba="0.055 0.055 0.065 1"/>
    <material name="forge_nut" rgba="0.84 0.84 0.88 1"/>
    <material name="recorded_tcp" rgba="0.1 1 0.2 0.85"/>
    <material name="replayed_tcp" rgba="1 0.1 0.8 0.85"/>
    <!-- Warm molded shell with low-gloss charcoal retained only on the thumb. -->
    <material name="hand_shell" rgba="0.94 0.93 0.90 1" specular="0.12" shininess="0.18"/>
    <material name="hand_rubber" rgba="0.035 0.040 0.040 1" specular="0.04" shininess="0.08"/>
    <material name="flange_black" rgba="0.025 0.025 0.025 1" specular="0.15" shininess="0.2"/>
