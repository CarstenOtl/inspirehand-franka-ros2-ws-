         saved environment flag names the walnut USD variant. -->
    <material name="recorded_table_top" rgba="0.93 0.93 0.91 1" roughness="0.55"/>
    <material name="recorded_table_leg" rgba="0.13 0.14 0.15 1" roughness="0.35" metallic="0.65"/>
