<mujoco model="fr3_inspirehand_replay">
  <!-- MuJoCo visualization scene for the recorded forgeUltra FR3 threading
       trajectory. The exact baked M24 meshes come from tiangong_infra_ws's
       tuned forgeultra_full_task_scene.xml. Workcell dimensions, presentation,
       robot transform, and hand kinematics match the recorded FR3 run.

       All mesh paths are relative to this file and stay inside this asset
       bundle. fr3_link8 is the flange frame, 107 mm beyond fr3_link7. The palm
       body uses forgeUltra franka-chi's zero-offset flange-to-palm quaternion
       (0.5, -0.5, -0.5, 0.5), in wxyz order. -->

  <compiler angle="radian" meshdir="./"/>

  <option integrator="implicitfast"/>

  <size nkey="1"/>

  <visual>
    <global azimuth="120" elevation="-20" offwidth="1280" offheight="720"/>
    <headlight ambient="0.45 0.45 0.45" diffuse="0.55 0.55 0.55" specular="0 0 0"/>
    <rgba haze="0.7 0.7 0.7 1"/>
  </visual>

  <default>
    <default class="fr3">
      <joint armature="0.195" damping="0.21" frictionloss="1.137"/>
      <site size="0.001 0.005 0.005" group="4" rgba="0.5 0.5 0.5 0.3"/>
      <general biastype="affine" biasprm="0 -1"/>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom type="mesh" group="3"/>
      </default>
    </default>

    <default class="training_hand">
      <joint damping="0.5" armature="0.02" frictionloss="0.02"/>
      <geom type="mesh" contype="0" conaffinity="0" group="1" rgba="1 1 1 1"/>
    </default>

  </default>

