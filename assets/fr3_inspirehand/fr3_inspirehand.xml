<mujoco model="fr3_inspirehand">
  <!-- Standalone MuJoCo model of the TienKung 2 Pro right hand mounted on an FR3.

       All mesh paths are relative to this file and stay inside this asset
       bundle. fr3_link8 is the flange frame, 107 mm beyond fr3_link7. The
       hand link transforms, inertias, joint limits and mimic ratios come from
       Open-X-Humanoid's official TienKung 2 Pro URDF. The pi-yaw flange adapter
       flips the hand from its zero-yaw pose and matches the physical FR3
       installation, 90 degrees from the legacy adapter. -->

  <compiler angle="radian" meshdir="./"/>

  <option integrator="implicitfast"/>

  <size nkey="1"/>

  <visual>
    <global azimuth="120" elevation="-20" offwidth="1280" offheight="720"/>
    <headlight ambient="0.3 0.3 0.3" diffuse="0.6 0.6 0.6" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
  </visual>

  <default>
    <default class="fr3">
      <joint armature="0.195" damping="0.21" frictionloss="1.137"/>
      <site size="0.001 0.005 0.005" group="4" rgba="0.5 0.5 0.5 0.3"/>
      <general biastype="affine" biasprm="0 -1"/>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom type="mesh" group="3"/>
      </default>
    </default>

    <!-- The official converter maps the hand's 50 N m URDF effort class to
         damping=1 and frictionloss=0.5. -->
    <default class="official_hand">
      <joint damping="1" frictionloss="0.5" actuatorfrcrange="-50 50"/>
      <default class="hand_visual">
        <geom type="mesh" contype="0" conaffinity="0" group="1" material="hand_shell" density="0"/>
      </default>
      <default class="hand_collision">
        <geom type="mesh" group="3" rgba="1 1 1 0"/>
      </default>
    </default>

  </default>

  <asset>
