# vcs repository list for inspire_franka.
#
#   vcs import src < workspace.repos      # first time
#   vcs pull src                          # update in place
#   vcs status src                        # see local modifications
#
# Only repos developed elsewhere belong here. The packages this repo owns
# (inspire_hand_msgs, inspire_hand_driver, inspire_hand_description,
# inspire_franka_description, inspire_franka_sim, inspire_franka_bringup) are
# committed under src/ directly and must not be listed.
#
# libfranka is deliberately absent, even though it IS a git repo: it carries a
# submodule (libfranka-common) that `vcs import` does not initialise, so a
# checkout here would fail to build. The dev image builds it into
# /opt/libfranka instead - see docker/Dockerfile.
repositories:
  franka_ros2:
    type: git
    url: https://github.com/frankarobotics/franka_ros2.git
    # The Jazzy line. v3.x is Jazzy-only; the 2.x series was Humble.
    # Pinned to a tag rather than a branch so a re-import cannot silently move.
    #
    # Do NOT run `vcs import src < src/franka_ros2/dependency.repos` as
    # upstream's README says to. It would clone a second copy of
    # franka_description (already below, same tag), a libfranka that will not
    # build here, and source checkouts of ros2_control, gz_ros2_control,
    # realsense/ZED/Robotiq descriptions and MoveIt - none of which this image
    # needs, because Jazzy's apt ros2_control is new enough for v3.5.x.
    #
    # docker/entrypoint.sh drops COLCON_IGNORE into the packages that would need
    # Gazebo, the full MoveIt stack, a mobile base, or RealSense/SICK/ZED
    # hardware, plus the vendored realtime_tools copy. Set
    # FRANKA_ROS2_BUILD_ALL=1 to opt back in and install those yourself.
    version: v3.5.3
  franka_description:
    type: git
    url: https://github.com/frankarobotics/franka_description.git
    # The version franka_ros2 v3.5.3's own dependency.repos pins. Bump the two
    # together, along with LIBFRANKA_REF in docker/Dockerfile.
    version: 2.9.0
