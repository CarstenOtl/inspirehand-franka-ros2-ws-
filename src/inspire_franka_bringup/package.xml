<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>inspire_franka_bringup</name>
  <version>0.1.0</version>
  <description>
    Bringup for the real hardware: the Franka FR3 over the FCI and the Inspire
    RH56 hand over RS485, individually or side by side.

    The two are independent stacks sharing a ROS graph and a TF tree. For
    coordinated control under one controller_manager, see inspire_franka_sim.
  </description>
  <maintainer email="boizbigd@gmail.com">Carsten Oertel</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- fci_check links libfranka directly; it deliberately uses no ROS at all,
       so that "can I reach the FCI" is answerable without a working workspace. -->
  <depend>libfranka</depend>

  <exec_depend>franka_bringup</exec_depend>
  <exec_depend>inspire_hand_driver</exec_depend>
  <exec_depend>inspire_hand_description</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
