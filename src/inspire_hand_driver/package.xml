<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
            schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>inspire_hand_driver</name>
  <version>0.1.0</version>
  <description>
    ROS 2 driver for the Inspire Robotics RH56 dexterous hand over RS485.

    Speaks both wire protocols the RH56 family ships with (Modbus RTU and
    Inspire's legacy EB 90 framing), and publishes joint states in radians
    against inspire_hand_description's URDF as well as in the hand's own
    open-ratio units.
  </description>
  <maintainer email="boizbigd@gmail.com">Carsten Oertel</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>inspire_hand_msgs</exec_depend>
  <exec_depend>python3-serial</exec_depend>

  <!-- Only the launch file's publish_description path needs these; the driver
       node itself has no description or visualisation dependency. -->
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>inspire_hand_description</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
