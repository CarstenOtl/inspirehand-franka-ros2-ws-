        <origin xyz="0.00946651884646 -0.00207630823867 -0.00720000588825" rpy="0 0 0" />
        <mass value="0.00985" />
        <inertia ixx="1.21069e-06" ixy="1.0767e-07" ixz="-1e-11" iyy="6.0118e-07" iyz="3e-11" izz="1.28966e-06" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://inspire_hand_description/meshes/left/thumb_intermediate.stl" />
        </geometry>
        <material name="${prefix}inspire_hand_shell">
          <color rgba="0.15 0.15 0.17 1.0" />
        </material>
      </visual>
      <collision>
