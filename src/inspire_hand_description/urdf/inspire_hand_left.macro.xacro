    <link name="${prefix}thumb_tip" />

    <link name="${prefix}index_tip" />

    <link name="${prefix}middle_tip" />

    <link name="${prefix}ring_tip" />

    <link name="${prefix}pinky_tip" />

    <joint name="${prefix}base_joint" type="fixed">
      <parent link="${prefix}hand_mount" />
      <child link="${prefix}hand_base_link" />
      <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>

    <joint name="${prefix}thumb_proximal_yaw_joint" type="revolute">
      <origin xyz="0.01696 -0.02045 0.06635" rpy="0 0 0" />
      <parent link="${prefix}hand_base_link" />
      <child link="${prefix}thumb_proximal_base" />
      <axis xyz="0 0 1" />
      <limit lower="0.246" upper="1.2554" effort="1" velocity="0.5" />
    </joint>

    <joint name="${prefix}index_proximal_joint" type="revolute">
      <origin xyz="-0.000285 -0.020275 0.136946" rpy="-1.5359 0 0" />
