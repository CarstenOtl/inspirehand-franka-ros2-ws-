    <link name="${prefix}thumb_distal">
      <inertial>
        <origin xyz="0.00604904909828 -0.00861522746372 -0.00600329390501" rpy="0 0 0" />
        <mass value="0.00552" />
        <inertia ixx="3.1668e-07" ixy="4.536e-08" ixz="1e-11" iyy="1.2999e-07" iyz="-4e-10" izz="3.3747e-07" />
