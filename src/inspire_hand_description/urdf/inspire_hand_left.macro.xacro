      <child link="${prefix}pinky_intermediate" />
      <axis xyz="0 0 1" />
      <limit lower="0" upper="1.527" effort="1" velocity="0.5" />
      <mimic joint="${prefix}pinky_proximal_joint" multiplier="1.1169" offset="0" />
