<?xml version="1.0"?>
<!--
  Geometry and masses from forgeUltra's inspirehand_right.urdf, the hand the policy
  was trained on. Thumb and index limits and the follower couplings are fitted to
  the real hand; see MODEL_PROVENANCE.md and inspire_hand_driver/kinematics.py.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="inspire_hand_left"
    params="prefix:='' parent:='' xyz:='0 0 0' rpy:='0 0 0'">

    <!-- Mount. With no parent the hand stands alone and hand_mount is the
         description's root link; with one, it is welded to that link. -->
    <xacro:unless value="${parent == ''}">
      <joint name="${prefix}hand_mount_joint" type="fixed">
        <origin xyz="${xyz}" rpy="${rpy}"/>
        <parent link="${parent}"/>
        <child link="${prefix}hand_mount"/>
      </joint>
    </xacro:unless>

    <link name="${prefix}hand_mount" />

    <link name="${prefix}hand_base_link">
      <inertial>
        <origin xyz="0.00252515168165 0.00196005492616 0.0660467739648" rpy="0 0 0" />
        <mass value="0.38756" />
        <inertia ixx="0.00059831308" ixy="-5.60829e-06" ixz="2.87014e-06" iyy="0.00050077156" iyz="-3.4831e-06" izz="0.00018467082" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://inspire_hand_description/meshes/left/hand_base_link.stl" />
        </geometry>
        <material name="${prefix}inspire_hand_shell">
          <color rgba="0.15 0.15 0.17 1.0" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://inspire_hand_description/meshes/left/hand_base_link.stl" />
        </geometry>
      </collision>
    </link>

    <link name="${prefix}index_proximal">
      <inertial>
        <origin xyz="0.000852715296527 -0.0119735955318 -0.00599986563267" rpy="0 0 0" />
        <mass value="0.01229" />
        <inertia ixx="1.93998e-06" ixy="1.5035e-07" ixz="-4.1e-10" iyy="5.6245e-07" iyz="3.49e-09" izz="2.05872e-06" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://inspire_hand_description/meshes/left/index_proximal.stl" />
        </geometry>
        <material name="${prefix}inspire_hand_shell">
          <color rgba="0.15 0.15 0.17 1.0" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://inspire_hand_description/meshes/left/index_proximal.stl" />
        </geometry>
      </collision>
    </link>

    <link name="${prefix}index_intermediate">
      <inertial>
        <origin xyz="0.0040834299919 -0.0192600939391 -0.00500000380847" rpy="0 0 0" />
        <mass value="0.00633" />
        <inertia ixx="9.4327e-07" ixy="3.8912e-07" ixz="-2e-11" iyy="2.897e-07" iyz="5e-11" izz="1.14024e-06" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
