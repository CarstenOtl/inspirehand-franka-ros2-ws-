        <origin xyz="0.00408287363348 -0.0192599767415 -0.00499998343104" rpy="0 0 0" />
        <mass value="0.00633" />
        <inertia ixx="9.4329e-07" ixy="3.8762e-07" ixz="-3.394e-08" iyy="2.9615e-07" iyz="7.389e-08" izz="1.13377e-06" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
