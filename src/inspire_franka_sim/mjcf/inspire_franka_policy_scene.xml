      rgb1="0.31 0.31 0.31" rgb2="0.31 0.31 0.31" markrgb="0.78 0.78 0.78"
      width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
      texrepeat="2 2" reflectance="0.05"/>
    <!-- forgeUltra assets/table/author_lab_bench_table.py: the walnut albedo
         at 3 repeats per metre, roughness 0.34. -->
    <texture type="2d" name="walnut" file="assets/forge_table/walnut_albedo.png"/>
    <material name="table_top" texture="walnut" texuniform="true" texrepeat="3 3" roughness="0.34"/>
    <material name="forge_bolt" rgba="0.055 0.055 0.065 1"/>
    <material name="forge_nut" rgba="0.84 0.84 0.88 1"/>
    <mesh name="forge_m24_nut" file="forge_m24/m24_nut.stl"/>
    <mesh name="forge_m24_bolt" file="forge_m24/m24_bolt.stl"/>
    <mesh name="m24_bolt_holder" file="forge_m24/m24_bolt_holder.stl"/>
  </asset>

  <include file="fr3v2.xml"/>

  <option gravity="0 0 0"/>

  <visual>
    <headlight ambient="0.45 0.45 0.45" diffuse="0.55 0.55 0.55" specular="0 0 0"/>
    <rgba haze="0.7 0.7 0.7 1"/>
    <global azimuth="120" elevation="-20" offwidth="1920" offheight="1080"/>
  </visual>

  <worldbody>
    <geom name="floor" pos="0 0 -0.75" size="0 0 0.05" type="plane" material="groundplane"/>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true" castshadow="false"/>
    <!-- mujoco_ros2_control renders every camera here, so this is the only one. -->
    <camera name="policy_d415" pos="0.0154367921 0.565516941 0.477093393" quat="-0.281033489 -0.204327776 0.538077981 0.767946889" resolution="640 480" sensorsize="0.00384 0.00288" focal="0.00361230981 0.00360416052" principal="7.21470337e-05 1.243396e-05"/>

