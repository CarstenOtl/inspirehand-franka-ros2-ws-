<mujoco model="fr3v2">
  <!-- MuJoCo Menagerie franka_fr3_v2 (see MJCF_PROVENANCE.md), with this
       package's local modifications: fr3_ names, motor actuators, a zeroed
       keyframe and the end-effector attachment slot. Joint friction, damping
       and armature are upstream's. -->
  <compiler angle="radian" meshdir="assets"/>

  <option integrator="implicitfast"/>

  <default>
    <default class="fr3v2">
      <!-- Overwritten in joints 5, 6, and 7. -->
      <joint damping="0.21" armature="0.195" frictionloss="1.137"/>
      <position inheritrange="1"/>
      <default class="visual">
        <geom type="mesh" group="2" contype="0" conaffinity="0"/>
      </default>
      <default class="collision">
        <geom type="mesh" group="3" mass="0" density="0"/>
      </default>
      <site size="0.001" rgba="0.5 0.5 0.5 0.3" group="4"/>
    </default>
  </default>

  <asset>
    <material name="black" rgba=".2 .2 .2 1"/>
    <material name="white" rgba="1 1 1 1"/>
    <material name="red" rgba="1 0.072272 0.039546 1"/>
    <material name="gray" rgba="0.863156 0.863156 0.863157 1"/>
    <material name="button_green" rgba="0.102241 0.571125 0.102242 1"/>
    <material name="button_red" rgba="0.520996 0.008023 0.013702 1"/>
    <material name="button_blue" rgba="0.024157 0.445201 0.737911 1"/>

    <mesh name="link0_0" file="fr3v2/link0_0.obj"/>
    <mesh name="link0_1" file="fr3v2/link0_1.obj"/>
    <mesh name="link0_2" file="fr3v2/link0_2.obj"/>
    <mesh name="link0_3" file="fr3v2/link0_3.obj"/>
    <mesh name="link0_4" file="fr3v2/link0_4.obj"/>
    <mesh name="link0_5" file="fr3v2/link0_5.obj"/>
    <mesh name="link1_3" file="fr3v2/link1_3.obj"/>
    <mesh name="link2_3" file="fr3v2/link2_3.obj"/>
    <mesh name="link3_3" file="fr3v2/link3_3.obj"/>
    <mesh name="link4_3" file="fr3v2/link4_3.obj"/>
    <mesh name="link5_3" file="fr3v2/link5_3.obj"/>
    <mesh name="link5_4" file="fr3v2/link5_4.obj"/>
    <mesh name="link6_0" file="fr3v2/link6_0.obj"/>
    <mesh name="link6_1" file="fr3v2/link6_1.obj"/>
    <mesh name="link6_2" file="fr3v2/link6_2.obj"/>
    <mesh name="link6_3" file="fr3v2/link6_3.obj"/>
    <mesh name="link6_4" file="fr3v2/link6_4.obj"/>
    <mesh name="link6_5" file="fr3v2/link6_5.obj"/>
    <mesh name="link6_6" file="fr3v2/link6_6.obj"/>
    <mesh name="link6_7" file="fr3v2/link6_7.obj"/>
    <mesh name="link6_8" file="fr3v2/link6_8.obj"/>
    <mesh name="link6_9" file="fr3v2/link6_9.obj"/>
    <mesh name="link7_0" file="fr3v2/link7_0.obj"/>
    <mesh name="link7_1" file="fr3v2/link7_1.obj"/>
    <mesh name="link7_2" file="fr3v2/link7_2.obj"/>
    <mesh name="link7_3" file="fr3v2/link7_3.obj"/>
    <mesh name="link7_4" file="fr3v2/link7_4.obj"/>
    <mesh name="link7_5" file="fr3v2/link7_5.obj"/>
    <mesh name="link7_6" file="fr3v2/link7_6.obj"/>

    <mesh name="link0_coll" file="fr3v2/link0.stl"/>
    <mesh name="link1_coll" file="fr3v2/link1.stl"/>
    <mesh name="link2_coll" file="fr3v2/link2.stl"/>
    <mesh name="link3_coll" file="fr3v2/link3.stl"/>
    <mesh name="link4_coll" file="fr3v2/link4.stl"/>
    <mesh name="link5_coll" file="fr3v2/link5.stl"/>
    <mesh name="link6_coll" file="fr3v2/link6.stl"/>
    <mesh name="link7_coll" file="fr3v2/link7.stl"/>
  </asset>

  <worldbody>
    <body name="base" childclass="fr3v2">
      <body name="fr3_link0">
        <geom mesh="link0_0" material="black" class="visual"/>
        <geom mesh="link0_1" material="white" class="visual"/>
        <geom mesh="link0_2" material="white" class="visual"/>
        <geom mesh="link0_3" material="white" class="visual"/>
        <geom mesh="link0_4" material="white" class="visual"/>
        <geom mesh="link0_5" material="red" class="visual"/>
        <geom name="fr3_link0_collision" mesh="link0_coll" class="collision"/>
        <inertial pos="-0.0172 0.0004 0.0745" quat="0.661377 -0.250161 -0.250161 0.661377" mass="3.85"
          diaginertia="0.0115 0.0107656 0.00673444"/>
        <body name="fr3_link1" pos="0 0 0.333">
          <inertial pos="-0.00458 0.027016 -0.0618" quat="0.989811 0.110789 0.00992127 0.0888923" mass="2.4377"
            diaginertia="0.0233003 0.0222611 0.00463865"/>
          <joint name="fr3_joint1" pos="0 0 0" axis="0 0 1" range="-2.9007 2.9007" actuatorfrcrange="-87 87"
            damping="0.003" frictionloss="0.2"/>
          <geom name="fr3_link1_collision" class="collision" mesh="link1_coll"/>
          <geom mesh="link1_3" material="white" class="visual"/>
          <body name="fr3_link2" quat="0.707107 -0.707107 0 0">
            <inertial pos="-0.003473 -0.168509 -0.010479" quat="0.644329 0.758803 -0.0323054 0.0895283" mass="2.2375"
              diaginertia="0.0192001 0.0173406 0.0052593"/>
            <joint name="fr3_joint2" pos="0 0 0" axis="0 0 1" range="-1.8361 1.8361" actuatorfrcrange="-87 87"
              damping="0.003" frictionloss="0.2"/>
            <geom name="fr3_link2_collision" class="collision" mesh="link2_coll"/>
            <geom mesh="link2_3" material="white" class="visual"/>
            <body name="fr3_link3" pos="0 -0.316 0" quat="0.707107 0.707107 0 0">
              <inertial pos="0.092968 0.01801 0.033533" quat="0.877348 -0.0280595 -0.265819 0.398514" mass="2.18579"
                diaginertia="0.0146052 0.0104212 0.00447362"/>
              <joint name="fr3_joint3" pos="0 0 0" axis="0 0 1" range="-2.9007 2.9007" actuatorfrcrange="-87 87"
                damping="0.003" frictionloss="0.2"/>
              <geom name="fr3_link3_collision" class="collision" mesh="link3_coll"/>
              <geom mesh="link3_3" material="white" class="visual"/>
              <body name="fr3_link4" pos="0.0825 0 0" quat="0.707107 0.707107 0 0">
                <inertial pos="-0.068745 0.092947 0.011195" quat="0.725019 0.567552 -0.379628 -0.0900828" mass="2.17587"
                  diaginertia="0.0126388 0.00973606 0.00442618"/>
                <joint name="fr3_joint4" pos="0 0 0" axis="0 0 1" range="-3.0770 -0.1169" actuatorfrcrange="-87 87"
                  damping="0.003" frictionloss="0.2"/>
                <geom name="fr3_link4_collision" class="collision" mesh="link4_coll"/>
                <geom mesh="link4_3" material="white" class="visual"/>
                <body name="fr3_link5" pos="-0.0825 0.384 0" quat="0.707107 -0.707107 0 0">
                  <inertial pos="-0.004197 0.010257 -0.058103" quat="0.993747 -0.0901363 0.0101557 0.0651102"
                    mass="2.17482" diaginertia="0.0318998 0.0305191 0.0038801"/>
                  <joint name="fr3_joint5" pos="0 0 0" axis="0 0 1" range="-2.8763 2.8763" actuatorfrcrange="-12 12"
                    damping="0.003" frictionloss="0.2"/>
                  <geom name="fr3_link5_collision" class="collision" mesh="link5_coll"/>
                  <geom mesh="link5_3" material="white" class="visual"/>
                  <body name="fr3_link6" quat="0.707107 0.707107 0 0">
                    <inertial pos="0.070958 -0.014137 -0.035324" quat="-0.141552 0.574736 0.130817 0.795317"
                      mass="1.56762" diaginertia="0.0047496 0.0041461 0.0024043"/>
                    <joint name="fr3_joint6" pos="0 0 0" axis="0 0 1" range="0.4398 4.6216" actuatorfrcrange="-12 12"
                      damping="0.003" frictionloss="0.2"/>
                    <geom name="fr3_link6_collision" class="collision" mesh="link6_coll"/>
                    <geom mesh="link6_0" material="gray" class="visual"/>
                    <geom mesh="link6_1" material="white" class="visual"/>
                    <geom mesh="link6_2" material="white" class="visual"/>
                    <geom mesh="link6_3" material="gray" class="visual"/>
                    <geom mesh="link6_4" material="button_red" class="visual"/>
                    <geom mesh="link6_5" material="button_red" class="visual"/>
                    <geom mesh="link6_6" material="black" class="visual"/>
                    <geom mesh="link6_7" material="white" class="visual"/>
                    <geom mesh="link6_8" material="button_red" class="visual"/>
                    <geom mesh="link6_9" material="white" class="visual"/>
                    <body name="fr3_link7" pos="0.088 0 0" quat="0.707107 0.707107 0 0">
                      <inertial pos="0.008204 0.001156 0.061016" quat="0.70836 0.00347393 0.0424735 0.704564"
                        mass="0.682876" diaginertia="0.00110022 0.000899844 0.000699938"/>
                      <joint name="fr3_joint7" pos="0 0 0" axis="0 0 1" range="-3.0508 3.0508"
                        actuatorfrcrange="-12 12" damping="0.003" frictionloss="0.2"/>
                      <geom name="fr3_link7_collision" class="collision" mesh="link7_coll"/>
                      <geom mesh="link7_0" material="white" class="visual"/>
                      <geom mesh="link7_1" material="white" class="visual"/>
                      <geom mesh="link7_2" material="white" class="visual"/>
                      <geom mesh="link7_3" material="white" class="visual"/>
                      <geom mesh="link7_4" material="white" class="visual"/>
                      <geom mesh="link7_5" material="white" class="visual"/>
                      <geom mesh="link7_6" material="white" class="visual"/>
                      <site name="attachment_site" pos="0 0 0.107"/>
                      <!-- LOCAL MODIFICATION 3: end-effector attachment point at the
                           fr3_link8 flange (franka_description joint8: xyz 0 0 0.107), as in
                           fr3.xml. `end_effector` is a model asset the scene supplies. -->
                      <frame pos="0 0 0.107">
                        <attach model="end_effector" prefix=""/>
                      </frame>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- LOCAL MODIFICATION 2: upstream's <position> servos rewritten to <motor>, as in
       fr3.xml (mujoco_ros2_control cannot command effort on a position actuator).
       ctrlrange mirrors each joint's actuatorfrcrange. -->
  <actuator>
    <motor class="fr3v2" name="fr3_joint1" joint="fr3_joint1" ctrlrange="-87 87"/>
    <motor class="fr3v2" name="fr3_joint2" joint="fr3_joint2" ctrlrange="-87 87"/>
    <motor class="fr3v2" name="fr3_joint3" joint="fr3_joint3" ctrlrange="-87 87"/>
    <motor class="fr3v2" name="fr3_joint4" joint="fr3_joint4" ctrlrange="-87 87"/>
    <motor class="fr3v2" name="fr3_joint5" joint="fr3_joint5" ctrlrange="-12 12"/>
    <motor class="fr3v2" name="fr3_joint6" joint="fr3_joint6" ctrlrange="-12 12"/>
    <motor class="fr3v2" name="fr3_joint7" joint="fr3_joint7" ctrlrange="-12 12"/>
  </actuator>

  <contact>
    <exclude body1="fr3_link0" body2="fr3_link1"/>
  </contact>

  <!-- LOCAL MODIFICATION 4: ctrl is a torque on a motor, so it is zeroed; qpos is
       Franka's documented home, as in fr3.xml. -->
  <keyframe>
    <key name="home"
         qpos="0 -0.785398 0 -2.356194 0 1.570796 0.785398"
         ctrl="0 0 0 0 0 0 0"/>
  </keyframe>
</mujoco>
