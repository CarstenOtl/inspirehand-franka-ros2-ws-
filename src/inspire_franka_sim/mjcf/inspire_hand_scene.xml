<mujoco model="inspire_hand_scene">
  <!-- The right Inspire hand on its own, standing on the floor. `arm:=false` in
       the sim launch.

       The hand is brought in as a model asset and <attach>ed rather than
       <include>d, so the scene decides where it goes: an include would drop it
       at the world origin with its palm through the floor. Same pattern as the
       bench scene, so the two place the hand identically. -->

  <asset>
    <model name="inspire_hand" file="inspire_hand_right.xml"/>
  </asset>

  <include file="scene_common.xml"/>

  <worldbody>
    <frame pos="0 0 0.05">
      <attach model="inspire_hand" prefix=""/>
    </frame>
  </worldbody>

  <!-- Keep keyframes on the final scene, not the reusable hand model. A child
       keyframe remains pending through <attach>, and nested attachment through
       inspire_hand_on_flange.xml makes MuJoCo unable to namespace it safely. -->
  <keyframe>
    <key name="open"
      qpos="0 0 0 0 0 -0.04545 0 -0.04545 0 -0.04545 0 -0.04545"/>
  </keyframe>
</mujoco>
