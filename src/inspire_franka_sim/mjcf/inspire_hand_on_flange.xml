<mujoco model="inspire_hand_on_flange">
  <!-- The Inspire hand as an FR3 end effector, for fr3.xml's `end_effector`
       attachment slot.

       This wrapper exists to do two things no_end_effector.xml also does, plus
       one it does not:

       - materialise the fr3_link8 body, which Menagerie's FR3 does not have
         (it ends at fr3_link7 plus `attachment_site`);
       - attach hand_mount to the flange 10 mm along +z with a 180-degree
         clocking angle. The 10 mm is the thickness of the black physical
         adapter flange. The hand model retains its internal
         hand_mount-to-hand_base_link rotation. Keep this transform equal to
         hand_flange_xyz/rpy in
       inspire_franka_description/urdf/inspire_franka.urdf.xacro. -->

  <asset>
    <model name="inspire_hand" file="inspire_hand_right.xml"/>
  </asset>

  <worldbody>
    <body name="fr3_link8">
      <!-- The point the Cartesian impedance TRAJECTORY REPLAY controls: the
           fingertip midpoint of a closed replay pinch, 172.7 mm from the
           flange, measured on this model and on inspire_hand_description's
           URDF, which agree to 0.1 mm. Keep equal to tcp.offset_xyz in
           inspire_franka_trajectory_replay/config/replay.yaml and to
           controllers_cartesian_impedance.yaml's tool_offset_xyz. Both sites
           are markers, so nothing in the physics depends on them. Group 4 is
           hidden by default: show it with the passive viewer's
           site_groups:=4. -->
      <site name="grasp_tcp" pos="-0.0874 -0.0327 0.1453" size="0.005"
        group="4" rgba="0.95 0.42 0.12 0.95"/>
      <!-- The point a POLICY ROLLOUT controls: the thumb/index fingertip
           midpoint at the threading grip in ForgeUltra's training hand
           geometry, 183.1 mm from the flange and 40 mm from grasp_tcp. Keep
           equal to tool_offset_xyz in controllers_policy.yaml and
           controllers_sim_policy.yaml, and to POLICY_TOOL_OFFSET_XYZ in
           apps/policy_rollout/policy_rollout/hardware.py. -->
      <site name="policy_grasp_tcp" pos="-0.059067 -0.028773 0.173311"
        size="0.005" group="4" rgba="0.15 0.85 0.35 0.95"/>
      <frame pos="0 0 0.010" quat="0 0 0 1">
        <attach model="inspire_hand" prefix=""/>
      </frame>
    </body>
  </worldbody>
</mujoco>
