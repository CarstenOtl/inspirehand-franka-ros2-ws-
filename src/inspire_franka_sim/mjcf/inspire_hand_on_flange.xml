<mujoco model="inspire_hand_on_flange">
  <!-- The Inspire hand as an FR3 end effector, for fr3.xml's `end_effector`
       attachment slot.

       This wrapper exists to do two things no_end_effector.xml also does, plus
       one it does not:

       - materialise the fr3_link8 body, which Menagerie's FR3 does not have
         (it ends at fr3_link7 plus `attachment_site`);
       - reproduce the current physical hand's clocking, accounting for this
         model's intermediate hand_mount frame.

       The physical hand is clocked 90 degrees from the legacy installation.
       This hand model already rotates hand_mount to hand_base_link by
       rpy=(-pi/2, 0, pi), so a pi-yaw flange adapter flips the hand from the
       zero-yaw pose. A 10 mm axial offset makes room for the black physical
       adapter flange. Keep this transform equal to hand_flange_xyz/rpy in
       inspire_franka_description/urdf/inspire_franka.urdf.xacro. -->

  <asset>
    <mesh name="hand_adapter_flange_mesh" file="assets_hand/adapter_flange.stl"/>
    <model name="inspire_hand" file="inspire_hand_right.xml"/>
  </asset>

  <worldbody>
    <body name="fr3_link8">
      <geom name="hand_adapter_flange" type="mesh" mesh="hand_adapter_flange_mesh"
        pos="0 0 0.005" rgba="0.025 0.025 0.025 1"
        contype="0" conaffinity="0" group="2"/>
      <frame pos="0 0 0.010" quat="0 0 0 1">
        <attach model="inspire_hand" prefix=""/>
      </frame>
    </body>
  </worldbody>
</mujoco>
