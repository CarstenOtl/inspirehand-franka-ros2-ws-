<mujoco model="inspire_franka_bench_scene">
  <!-- The default scene: an FR3 with a bare flange, and the Inspire hand
       standing on the bench beside it. Two independent assets sharing a world
       and a controller_manager - which is how the real setup is wired.

       The hand's placement here must match hand_bench_xyz/rpy in
       inspire_franka_description/urdf/inspire_franka.urdf.xacro, or MuJoCo and
       TF disagree about where the hand is. test/test_mjcf.py checks that. -->

  <!-- Both must precede the include: fr3.xml's <attach> resolves `end_effector`
       at parse time. -->
  <asset>
    <model name="end_effector" file="no_end_effector.xml"/>
    <model name="inspire_hand" file="inspire_hand_right.xml"/>
  </asset>

  <include file="fr3v2.xml"/>
  <include file="scene_common.xml"/>

  <worldbody>
    <frame pos="0.45 -0.35 0" quat="1 0 0 0">
      <attach model="inspire_hand" prefix=""/>
    </frame>
  </worldbody>

  <!--
    A combined rest pose, under a third name.

    fr3.xml defines "home" for the arm's seven joints, and MuJoCo zero-pads
    it to the full model. With the training hand every joint is 0 at the open
    pose, so that padding happens to be right; the combined pose still gets its
    own name and spells the hand out, so it stays right if a coupling ever
    gains an offset again (the dex-urdf hand's followers sat at -0.04545).

    Order is model order: the arm's seven joints, then the hand's twelve as
    inspire_hand_right.xml declares them (thumb yaw, thumb pitch, thumb
    intermediate, thumb distal, then index/middle/ring/pinky proximal and
    intermediate in pairs).
  -->
  <keyframe>
    <key name="start"
      qpos="0 -0.785398163 0 -2.35619449 0 1.57079633 0.785398163 0.246 -0.086 -0.0787912 -0.037860039 -0.05 -0.016835 0 0 0 0 0 0"/>
  </keyframe>
</mujoco>
