<?xml version="1.0" encoding="utf-8"?>
<!--
  FR3 with the MuJoCo ros2_control system in place of franka_hardware.

  Same links/joints as franka_bringup's franka_arm.urdf.xacro (via franka_description), but a
  minimal ros2_control block: the seven arm joints with position/velocity/effort command and
  state interfaces, which is all the replay controller and the broadcasters need.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="$(arg robot_type)">
  <xacro:arg name="robot_type" default="fr3"/>
  <xacro:include filename="$(find franka_description)/robots/$(arg robot_type)/$(arg robot_type).urdf.xacro"/>

  <xacro:arg name="model_path" default="$(find franka_mujoco_hardware)/mujoco/scene.xml"/>
  <xacro:arg name="stiffness" default="3000 3000 3000 2500 2500 2000 2000"/>
  <xacro:arg name="damping" default="60 60 60 50 40 20 15"/>
  <xacro:arg name="initial_positions" default="0 -0.785398 0 -2.356194 0 1.570796 0.785398"/>
  <xacro:arg name="reflex_on_violation" default="true"/>
  <xacro:arg name="gravity_compensation" default="true"/>

  <xacro:property name="joint_prefix" value="${modified_prefix}$(arg robot_type)"/>

  <ros2_control name="${modified_prefix}FrankaMujocoSystem" type="system">
    <hardware>
      <plugin>franka_mujoco_hardware/MujocoSystem</plugin>
      <param name="model_path">$(arg model_path)</param>
      <param name="stiffness">$(arg stiffness)</param>
      <param name="damping">$(arg damping)</param>
      <param name="initial_positions">$(arg initial_positions)</param>
      <param name="reflex_on_violation">$(arg reflex_on_violation)</param>
      <param name="gravity_compensation">$(arg gravity_compensation)</param>
    </hardware>
    <xacro:macro name="mujoco_joint" params="name">
      <joint name="${name}">
        <command_interface name="position"/>
        <command_interface name="velocity"/>
        <command_interface name="effort"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
        <state_interface name="effort"/>
      </joint>
    </xacro:macro>
    <xacro:mujoco_joint name="${joint_prefix}_joint1"/>
    <xacro:mujoco_joint name="${joint_prefix}_joint2"/>
    <xacro:mujoco_joint name="${joint_prefix}_joint3"/>
    <xacro:mujoco_joint name="${joint_prefix}_joint4"/>
    <xacro:mujoco_joint name="${joint_prefix}_joint5"/>
    <xacro:mujoco_joint name="${joint_prefix}_joint6"/>
    <xacro:mujoco_joint name="${joint_prefix}_joint7"/>
  </ros2_control>
</robot>
