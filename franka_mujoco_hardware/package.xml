<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>franka_mujoco_hardware</name>
  <version>0.1.0</version>
  <description>
    ros2_control system interface that stands in for franka_hardware with a MuJoCo model of the
    FR3, including an emulation of the robot's internal joint impedance controller and of the
    motion generator limit checks that make the real arm reflex.
  </description>
  <maintainer email="boizbigd@gmail.com">Carsten Oertel</maintainer>
  <license>Apache 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>

  <exec_depend>franka_description</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <hardware_interface plugin="${prefix}/franka_mujoco_hardware.xml"/>
  </export>
</package>
